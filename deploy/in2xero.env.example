# Install to /etc/in2xero/in2xero.env
#   sudo chown root:root /etc/in2xero/in2xero.env
#   sudo chmod 600      /etc/in2xero/in2xero.env
#
# These are referenced from config.yaml as ${NAME}. If any is missing,
# in2xero fails loudly at startup rather than running with a blank value.

# Invoice Ninja: Settings > Account Management > API Tokens
IN_API_TOKEN=

# Xero: developer.xero.com > your Custom Connection app
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Your Xero organisation id. `in2xero auth` prints it.
XERO_TENANT_ID=
